{
  "name": "lims-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:browser": "playwright test --config=playwright.config.browser.ts",
    "test:e2e:browser:headed": "playwright test --config=playwright.config.browser.ts --headed",
    "test:e2e:browser:debug": "playwright test --config=playwright.config.browser.ts --debug",
    "test:e2e:browser:report": "playwright show-report --config=playwright.config.browser.ts",
    "test:e2e:browser:chrome": "playwright test --config=playwright.config.browser.ts --project=chromium",
    "test:e2e:browser:firefox": "playwright test --config=playwright.config.browser.ts --project=firefox",
    "test:e2e:browser:mobile": "playwright test --config=playwright.config.browser.ts --project=mobile-chrome"
  },
  "dependencies": {
    "@sentry/nextjs": "^8.0.0",
    "axios": "^1.7.2",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.14.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.395.0",
    "next": "14.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.3",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5"
  }
}
