{
    # Internal CA configuration
    pki {
        ca local {
            name "LIMS Internal CA"
            root_cn "LIMS Root CA"
        }
    }
}

aldrasat.edu {
    tls internal               # Self-signed local certificate via Internal CA
    encode gzip

    # API proxy — point to host for local dev
    reverse_proxy /api/v1/* {env.BACKEND_URL}
    reverse_proxy /uploads/* {env.BACKEND_URL}

    # Frontend fallback
    reverse_proxy * {env.FRONTEND_URL}
}
