# Shared security headers
(security_headers) {
    header {
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https://api.example.com; form-action 'self'"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        X-XSS-Protection "0"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }
}

# API-only gateway — the frontends are hosted on Vercel and rewrite their
# /api/* calls to this host (path-based routing on :80, no DNS required).
#   - /api/v1/events/stream → ERP backend, realtime SSE (unbuffered, see below)
#   - /api/v1/*  → ERP backend
#   - /uploads/* → ERP backend (cert/receipt/attachment files)
#   - /api/*     → portal BFF (portal routes are /api/auth, /api/me, ...)
:80 {
    # Realtime SSE. Must come before the catch-all /api/v1/* handler — `handle`
    # blocks are mutually exclusive, so the more specific path wins.
    #
    # flush_interval -1 disables response buffering. Without it Caddy batches
    # the stream and realtime events appear to do nothing until the connection
    # closes. gzip is deliberately NOT applied here: compressing a stream adds a
    # buffer and re-introduces exactly the latency this route exists to avoid.
    handle /api/v1/events/stream {
        reverse_proxy {env.BACKEND_URL} {
            flush_interval -1
        }
    }

    handle /uploads/* {
        encode gzip
        reverse_proxy {env.BACKEND_URL}
    }

    handle /api/v1/* {
        encode gzip
        reverse_proxy {env.BACKEND_URL}
    }

    handle /api/* {
        encode gzip
        reverse_proxy {env.PORTAL_BACKEND_URL}
    }

    import security_headers
}

# Production hostnames — enable when DNS is pointed at this server (or the
# tunnel routes to Caddy). Frontends are on Vercel; these serve APIs only.
erp.aldirasat.edu {
    handle /api/v1/events/stream {
        reverse_proxy {env.BACKEND_URL} {
            flush_interval -1
        }
    }

    handle /uploads/* {
        encode gzip
        reverse_proxy {env.BACKEND_URL}
    }

    handle /api/v1/* {
        encode gzip
        reverse_proxy {env.BACKEND_URL}
    }

    import security_headers
}

portal.aldirasat.edu {
    # Cap request sizes (portal accepts JSON, never big uploads).
    request_body {
        max_size 2MB
    }

    handle /api/* {
        encode gzip
        reverse_proxy {env.PORTAL_BACKEND_URL}
    }

    import security_headers
}
