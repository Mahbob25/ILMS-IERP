# Shared security headers
(security_headers) {
    header {
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https://api.example.com; form-action 'self'"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        X-XSS-Protection "0"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }
}

# API-only gateway — the frontends are hosted on Vercel and rewrite their
# /api/* calls to this host (path-based routing on :80, no DNS required).
#   - /api/v1/*  → ERP backend
#   - /uploads/* → ERP backend (cert/receipt/attachment files)
#   - /api/*     → portal BFF (portal routes are /api/auth, /api/me, ...)
:80 {
    encode gzip

    reverse_proxy /api/v1/* {env.BACKEND_URL}
    reverse_proxy /uploads/* {env.BACKEND_URL}
    reverse_proxy /api/* {env.PORTAL_BACKEND_URL}

    import security_headers
}

# Production hostnames — enable when DNS is pointed at this server (or the
# tunnel routes to Caddy). Frontends are on Vercel; these serve APIs only.
erp.aldirasat.edu {
    encode gzip
    reverse_proxy /api/v1/* {env.BACKEND_URL}
    reverse_proxy /uploads/* {env.BACKEND_URL}
    import security_headers
}

portal.aldirasat.edu {
    encode gzip

    # Cap request sizes (portal accepts JSON, never big uploads).
    request_body {
        max_size 2MB
    }

    reverse_proxy /api/* {env.PORTAL_BACKEND_URL}
    import security_headers
}
