# ── Database ──────────────────────────────────────────
# Copy this file to .env and fill in real values.
POSTGRES_USER=lims
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=lims

# ── JWT Auth ──────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change_me_random_base64_key

# ── Application ───────────────────────────────────────
ENVIRONMENT=production
# Main site + portal subdomain (change to your actual host if running on a
# public IP before buying the domain).
CORS_ORIGINS=https://aldirasat.com,https://portal.aldirasat.com
TIMEZONE=Asia/Riyadh

# ── Monitoring ────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── Cloudflare Tunnel ─────────────────────────────────
# From Cloudflare Zero Trust → Networks → Tunnels → your tunnel → token
TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# ── Portal (Phase 0 — internal API + future BFF) ──────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
PORTAL_JWT_SECRET=change_me_portal_jwt_secret_48_chars
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ERP_SERVICE_KEY=change_me_service_key_32_chars

# ── Shared Redis (ERP + portal BFF + ai-service) ──────
# ONE instance, owned by docker-compose.yml (service `redis`). Never declare
# a second `redis` service in docker-compose.portal.yml.
# scripts/setup.sh generates REDIS_PASSWORD and rewrites REDIS_URL to match.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
REDIS_PASSWORD=change_me_redis_password
# Client URL for every backend. Point this at a cloud-managed Redis
# (ElastiCache/Upstash, rediss://...) to move off the container.
REDIS_URL=redis://:change_me_redis_password@redis:6379/0
# Memory cap. Keep BELOW the redis container's memory limit (256M) so Redis
# self-limits instead of being OOM-killed. Policy must stay volatile-lru:
# it evicts only TTL'd cache keys and never the ai:* job streams.
REDIS_MAXMEMORY=192mb
REDIS_MAXMEMORY_POLICY=volatile-lru

GEMINI_API_KEY=
OPENAI_API_KEY=

# ── Unified login (SSO between ERP and portal) ────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# MUST be the SAME value in the ERP .env and the portal compose file.
PORTAL_SSO_SECRET=change_me_shared_sso_secret_48_chars
# Where the ERP frontend sends students/parents after login.
PORTAL_FRONTEND_URL=https://aldirasat-portal.vercel.app
# Used by the ERP frontend to build the SSO redirect URL.
NEXT_PUBLIC_PORTAL_URL=https://aldirasat-portal.vercel.app
