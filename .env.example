# ── Database ──────────────────────────────────────────
# Copy this file to .env and fill in real values.
POSTGRES_USER=lims
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=lims

# ── JWT Auth ──────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change_me_random_base64_key

# ── Application ───────────────────────────────────────
ENVIRONMENT=production
# Main site + portal subdomain (change to your actual host if running on a
# public IP before buying the domain).
CORS_ORIGINS=https://aldirasat.com,https://portal.aldirasat.com
TIMEZONE=Asia/Riyadh

# ── Monitoring ────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── Cloudflare Tunnel ─────────────────────────────────
# From Cloudflare Zero Trust → Networks → Tunnels → your tunnel → token
TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# ── Portal (Phase 0 — internal API + future BFF) ──────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
PORTAL_JWT_SECRET=change_me_portal_jwt_secret_48_chars
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ERP_SERVICE_KEY=change_me_service_key_32_chars
REDIS_URL=redis://redis:6379/0
GEMINI_API_KEY=
OPENAI_API_KEY=

# ── Unified login (SSO between ERP and portal) ────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# MUST be the SAME value in the ERP .env and the portal compose file.
PORTAL_SSO_SECRET=change_me_shared_sso_secret_48_chars
# Where the ERP frontend sends students/parents after login.
PORTAL_FRONTEND_URL=https://portal.aldirasat.com
# Used by the ERP frontend to build the SSO redirect URL.
NEXT_PUBLIC_PORTAL_URL=https://portal.aldirasat.com
